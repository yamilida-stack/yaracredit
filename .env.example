# Variables de Entorno de Ejemplo
# Copia este archivo a .env y configura tus valores

# Nombre de la aplicación
VITE_APP_NAME=YaraCredit

# URL de la API (si usas backend)
VITE_API_URL=https://api.tu-dominio.com

# Supabase (si usas base de datos en la nube)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Configuración de WhatsApp Business API (opcional)
VITE_WHATSAPP_API_TOKEN=tu-token-aqui
VITE_WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id

# Configuración de impresión térmica (opcional)
VITE_PRINT_SERVICE_URL=https://print-service.tu-dominio.com

# Google Maps API Key (para geolocalización)
VITE_GOOGLE_MAPS_KEY=tu-google-maps-key

# Configuración de backup automático
VITE_AUTO_BACKUP_ENABLED=true
VITE_BACKUP_INTERVAL_HOURS=24

# Configuración de notificaciones push
VITE_PUSH_NOTIFICATIONS_ENABLED=true
VITE_VAPID_PUBLIC_KEY=tu-vapid-public-key
